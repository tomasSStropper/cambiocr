# Token de la API SDDE del BCCR (sitio nuevo de Indicadores Economicos -> Mi Perfil -> Generar).
# Copie este archivo como .env y pegue el token ahi. .env esta en .gitignore: no se sube.
BCCR_TOKEN=

# SMTP para envio de confirmacion de alertas
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Remitente para correos de alerta
ALERT_FROM=alertas@cambioya.com
